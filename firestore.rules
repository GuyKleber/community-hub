rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        "guykleber1@gmail.com",
        "pccchurchoffice145@gmail.com"
      ];
    }

    match /tacoBarSignups/{signupId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(["name", "bringing", "createdAt"]) &&
        request.resource.data.name is string &&
        request.resource.data.bringing is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.bringing.size() > 0 &&
        request.resource.data.bringing.size() <= 120;
      allow update, delete: if isAdmin();
    }

    match /siteContent/{pageId} {
      allow read: if true;
      allow write: if
        isAdmin() &&
        pageId.matches("^(siteSettings|home|about|beliefs|missions|purpose|history|calendar|thisWeek|booknight|womensTea|campfire|newsletter|donations|churchRental|tacoBarSignup)$");
    }
  }
}
